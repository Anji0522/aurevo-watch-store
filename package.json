{
  "name": "aurevo-watch-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:client:dev\"",
    "client:dev": "vite --config client/vite.config.js",
    "server:dev": "nodemon server/index.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "seed": "node server/scripts/seed.js",
    "test": "node --test",
    "lint": "eslint client/src server tests --ext .js,.jsx",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"tests/**/*.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.3",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1",
    "vite": "^6.0.7"
  }
}
