{
  "name": "aurevo-watch-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:client:dev\"",
    "client:dev": "vite --config client/vite.config.js",
    "server:dev": "node --watch server/index.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "seed": "node server/scripts/seed.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --test tests/*.test.js",
    "test:client": "vitest run --config client/vitest.config.js",
    "test:e2e": "playwright test --config playwright.config.js",
    "lint": "eslint client/src server tests e2e playwright.config.js eslint.config.js",
    "format": "prettier --write \"client/**/*.{js,jsx,css,html}\" \"server/**/*.js\" \"tests/**/*.js\" \"e2e/**/*.js\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"client/**/*.{js,jsx,css,html}\" \"server/**/*.js\" \"tests/**/*.js\" \"e2e/**/*.js\" \"*.{js,json,md}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.3",
    "express-validator": "^7.3.2",
    "framer-motion": "^14.9.1",
    "gsap": "^3.15.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.27",
    "lottie-react": "^3.1.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.179.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vite": "^6.0.7",
    "vitest": "^5.1.0"
  }
}
